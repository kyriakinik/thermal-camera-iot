# ==========================================
# ECE490 Thermal Fire Detection - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials:
#   cp .env.example .env
# ==========================================

# MQTT Broker Configuration
MQTT_BROKER=194.177.207.38
MQTT_PORT=1883
MQTT_USERNAME=team1
MQTT_PASSWORD=your_mqtt_password_here

# InfluxDB Configuration
INFLUXDB_URL=http://194.177.207.38:8086
DB_NAME=edge08_db
DB_USERNAME=edge08
DB_PASSWORD=your_influx_password_here

# Discord Alerting Webhook
# Generate in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
ALERT_COOLDOWN_SECONDS=10
